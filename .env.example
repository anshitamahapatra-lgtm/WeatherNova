DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
SQL_ECHO=false
VITE_API_BASE_URL=https://weathernova-4.onrender.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_TOKEN_SECRET=change-me

# Real social-media hashtag ingestion is disabled until a provider and token are set.
SOCIAL_MEDIA_PROVIDER=
SOCIAL_MEDIA_BEARER_TOKEN=
SOCIAL_HASHTAGS=#IMD,#Weather,#RainAlert

# Public dataset / website / API ingestion sources, comma separated.
PUBLIC_DATASET_URLS=
PUBLIC_WEBSITE_URLS=
PUBLIC_API_URLS=

# Kafka/Spark runtime integration. Leave blank unless the services are deployed.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_WEATHER_TOPIC=weathernova.weather.reports
KAFKA_SKIP_RUNTIME_CHECK=false
SPARK_MASTER_URL=
SPARK_SKIP_RUNTIME_CHECK=false

# Binary upload/storage is not implemented unless a real storage backend is configured.
MEDIA_STORAGE_PROVIDER=
MEDIA_STORAGE_BASE_URL=
